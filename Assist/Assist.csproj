<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <StartupObject></StartupObject>
        <SignAssembly>False</SignAssembly>
        <ApplicationIcon>./Assets/Assist_IconBlack.ico</ApplicationIcon>
        <Company>Mike Creations LLC</Company>
        <Version>1.0.16</Version>
        <LangVersion>default</LangVersion>
        <PackageIcon>Assets\Default\Assist_Logo_White.png</PackageIcon>
        <RepositoryUrl>https://github.com/HeyM1ke/Assist</RepositoryUrl>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
      <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
        <None Remove=".gitignore" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="Roots.xml" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="[3.2.1,4.0.0)" />
        <PackageReference Include="Avalonia" Version="[11.0.10,12.0.0)" />
        <PackageReference Include="Avalonia.Desktop" Version="[11.0.10,12.0.0)" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Condition="'$(Configuration)' == 'Debug'" Include="Avalonia.Diagnostics" Version="[11.0.10,12.0.0)" />
        <PackageReference Include="Avalonia.Skia" Version="[11.0.10,12.0.0)" />
        <PackageReference Include="Avalonia.Svg.Skia" Version="[11.0.0.16,12.0.0)" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="[11.0.10,12.0.0)" />
        <PackageReference Include="CliWrap" Version="[3.6.6,4.0.0)" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="[8.2.2,9.0.0)" />
        <PackageReference Include="DiscordRichPresence" Version="[1.2.1.24,2.0.0)" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="[8.0.3,9.0.0)" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="[8.0.0,9.0.0)" />
        <PackageReference Include="Serilog" Version="[3.1.1,4.0.0)" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="[8.0.0,9.0.0)" />
        <PackageReference Include="Serilog.Sinks.Console" Version="[5.0.1,6.0.0)" />
        <PackageReference Include="Serilog.Sinks.File" Version="[5.0.0,6.0.0)" />
        <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="[7.4.1,8.0.0)" />
        <PackageReference Include="System.Management" Version="[8.0.0,9.0.0)" />
        <PackageReference Include="System.Text.Json" Version="[8.0.5,9.0.0)" />
        <PackageReference Include="Velopack" Version="[0.0.359,1.0.0)" />
        <PackageReference Include="websocketsharp.core" Version="[1.0.0,2.0.0)" />
        <PackageReference Include="YamlDotNet" Version="[15.1.0,16.0.0)" />
        <PackageReference Include="Microsoft.Web.WebView2" Version="[1.0.1185.39,2.0.0)" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Themes\Index.xaml" />
      <AvaloniaXaml Include="Themes\Index.xaml" />
    </ItemGroup>

    <ItemGroup>
      <Reference Include="AssistUser.Lib">
        <HintPath>Library\AssistUser.Lib.dll</HintPath>
      </Reference>
      <!-- Replace binary Valnet reference with project reference -->
    </ItemGroup>

  <ItemGroup>
      <ProjectReference Include="..\Assist.Shared\Assist.Shared\Assist.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Valnet">
      <HintPath>Library\Valnet.dll</HintPath>
    </Reference>
  </ItemGroup>

    <ItemGroup>
      <Compile Update="Properties\Resources.Designer.cs">
        <DesignTime>True</DesignTime>
        <AutoGen>True</AutoGen>
        <DependentUpon>Resources.resx</DependentUpon>
      </Compile>
      <Compile Update="Views\Leagues\LeaguesView.axaml.cs">
        <DependentUpon>LeaguesView.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Properties\Resources.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>
</Project>
