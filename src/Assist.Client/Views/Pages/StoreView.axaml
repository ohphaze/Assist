<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Assist.Client.ViewModels"
             xmlns:models="using:Assist.Core.Models"
             mc:Ignorable="d"
             x:Class="Assist.Client.Views.Pages.StoreView"
             x:DataType="vm:StoreViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Store rotation" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Check what is available before launching the game." FontSize="12" Opacity="0.7" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Offers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="260" ItemHeight="200" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:StoreOffer">
                        <Border Background="#181a20" CornerRadius="12" Padding="12" Margin="0 0 12 12" Width="240" Height="180">
                            <StackPanel>
                                <TextBlock Text="{Binding ItemName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ItemType}" FontSize="12" Opacity="0.7" />
                                <TextBlock Text="{Binding Cost, StringFormat='Cost: {0}'}" FontSize="14" FontWeight="SemiBold" Margin="0 12 0 0" />
                                <TextBlock Text="{Binding ExpiresAt, StringFormat='Expires {0:MMM d HH:mm}'}" FontSize="11" Opacity="0.5" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Error}" Foreground="Red" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
