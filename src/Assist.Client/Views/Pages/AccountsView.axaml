<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Assist.Client.ViewModels"
             xmlns:models="using:Assist.Core.Models"
             xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             mc:Ignorable="d"
             x:Class="Assist.Client.Views.Pages.AccountsView"
             x:Name="Root"
             x:DataType="vm:AccountsViewModel">
    <Grid ColumnDefinitions="2*,*" ColumnSpacing="24">
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Saved accounts" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Switch between profiles without re-entering credentials." FontSize="12" Opacity="0.7" />
            </StackPanel>
            <Border Background="#181a20" CornerRadius="8" Padding="12">
                <StackPanel Spacing="12">
                    <ListBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" Background="Transparent" BorderBrush="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ValorantAccount">
                                <Border Background="#20222a" CornerRadius="6" Padding="12" Margin="0 0 0 8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding Region}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{Binding TagLine, StringFormat='#{0}'}" FontSize="12" Opacity="0.7" />
                                            <TextBlock Text="{Binding LastUsedAt, StringFormat='Last used {0:g}'}" FontSize="12" Opacity="0.5" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                            <Button Content="Set Active"
                                                    Command="{Binding DataContext.SetActiveCommand, ElementName=Root}"
                                                    CommandParameter="{Binding .}"
                                                    HorizontalAlignment="Left" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="Remove selected"
                            Command="{Binding RemoveSelectedCommand}"
                            IsEnabled="{Binding SelectedAccount, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Column="1" Background="#181a20" CornerRadius="8" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Add a new account" FontSize="18" FontWeight="SemiBold" />
                <TextBox Watermark="Display name" Text="{Binding DisplayName}" />
                <TextBox Watermark="Tagline" Text="{Binding TagLine}" />
                <ComboBox ItemsSource="{Binding Regions}" SelectedItem="{Binding Region}" />
                <TextBox Watermark="Notes" Text="{Binding Notes}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap" />
                <CheckBox Content="Requires two-factor authentication" IsChecked="{Binding RequiresSecondFactor}" />
                <Button Content="Add account" Command="{Binding AddAccountCommand}" />
                <TextBlock Text="{Binding Error}" Foreground="Red" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
