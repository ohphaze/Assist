<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Assist.Client.ViewModels"
             mc:Ignorable="d"
             x:Class="Assist.Client.Views.Pages.ModulesView"
             x:Name="Root"
             x:DataType="vm:ModulesViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="Modules" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Toggle integrations and helper tools." FontSize="12" Opacity="0.7" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Modules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModuleItemViewModel">
                        <Border Background="#181a20" CornerRadius="8" Padding="12" Margin="0 0 0 12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Description}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Category}" FontSize="11" Opacity="0.6" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding IsEnabled}"
                                              HorizontalAlignment="Right"
                                              Command="{Binding DataContext.ToggleModuleCommand, ElementName=Root}"
                                              CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Error}" Foreground="Red" FontSize="12" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
